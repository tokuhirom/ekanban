#!/usr/bin/env bash
# ekanban-core が UI ツールキットに依存していないことを確かめる。
#
# `crates/core` に gpui も tauri も入れないのは、移行の全体を支えている前提です
# (`docs/TAURI-MIGRATION.md` §1)。テストが GUI のランタイム無しで走り続けること、
# Tauri のアプリと開発用のハーネスが同じコードを使えることが、これで決まります。
#
# Cargo.toml を読むだけでは足りません。依存の依存から引きずり込むほうが、
# 手で書いて足すよりありがちなので、解決した依存グラフを見ます。
set -euo pipefail

cd "$(dirname "$0")/.."

# 見るクレートと、そこに入ってはいけない依存の名前の先頭。
#
#   ekanban-core  gpui も tauri も入らない。これが移行の全体を支えている前提です
#   ekanban-app   tauri は段階 3 で入りますが、gpui は最後まで入りません
check() {
  local package=$1 forbidden=$2 reason=$3
  local found
  found=$(cargo tree --package "$package" --edges normal,build --prefix none --no-dedupe \
    | awk '{print $1}' | sort -u | grep -E "$forbidden" || true)
  if [ -n "$found" ]; then
    echo "$package に入ってはいけない依存があります:" >&2
    echo "$found" | sed 's/^/  /' >&2
    echo >&2
    echo "$reason" >&2
    return 1
  fi
  echo "$package: ok"
}

status=0
check ekanban-core '^(gpui|tauri)' \
  "docs/TAURI-MIGRATION.md §1 を読んでください。中核は gpui にも tauri にも依存しません。
依存が要るなら crates/app か crates/gpui に置いてください。" || status=1
check ekanban-app '^gpui' \
  "crates/app は Tauri の側です。gpui のものを使う理由はありません。" || status=1
exit "$status"
