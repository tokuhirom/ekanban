#!/usr/bin/env bash
# ekanban-core が UI ツールキットに依存していないことを確かめる。
#
# `crates/core` に UI のものを入れないのは、テストが GUI のランタイム無しで
# 走り続けること、アプリと開発用のハーネスが同じコードを使えることが、
# これで決まるからです (`docs/DESIGN.md`)。
#
# Cargo.toml を読むだけでは足りません。依存の依存から引きずり込むほうが、
# 手で書いて足すよりありがちなので、解決した依存グラフを見ます。
set -euo pipefail

cd "$(dirname "$0")/.."

# 見るクレートと、そこに入ってはいけない依存の名前の先頭。
#
#   ekanban-core  tauri が入らない。中核は画面の作りを知りません
check() {
  local package=$1 forbidden=$2 reason=$3
  local found
  found=$(cargo tree --package "$package" --edges normal,build --prefix none --no-dedupe \
    | awk '{print $1}' | sort -u | grep -E "$forbidden" || true)
  if [ -n "$found" ]; then
    echo "$package に入ってはいけない依存があります:" >&2
    echo "$found" | sed 's/^/  /' >&2
    echo >&2
    echo "$reason" >&2
    return 1
  fi
  echo "$package: ok"
}

status=0
check ekanban-core '^tauri' \
  "docs/DESIGN.md を読んでください。中核は画面の作りを知りません。
Tauri に触る依存が要るなら crates/app に置いてください。" || status=1
exit "$status"
