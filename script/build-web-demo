#!/usr/bin/env bash
# ブラウザ版（ADR 0035）を組み立てる。
#
#   script/build-web-demo
#
# 出来上がるのは `web/dist-demo/` で、そのまま静的なページとして置けます
# （GitHub Pages に置いているのがこれです）。
#
# 2 段です。**wasm を先に作ります**——`web/wasm/` に出たものを Vite が資産として
# 運ぶので、無いと画面側の組み立てが「そんなモジュールは無い」で落ちます。
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

if ! command -v wasm-pack >/dev/null 2>&1; then
  echo "wasm-pack が要ります: https://rustwasm.github.io/wasm-pack/installer/" >&2
  exit 1
fi

# `--target web` は、素の `<script type="module">` から読める形。バンドラ用の
# 形にすると、Vite の設定に wasm の扱いを足すことになります。
wasm-pack build crates/web \
  --target web \
  --out-dir ../../web/wasm \
  --out-name ekanban_web \
  --release

npm --prefix web run build:demo
