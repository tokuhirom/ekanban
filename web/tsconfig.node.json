{
  "compilerOptions": {
    "target": "ES2022",
    // `$$eval` / `evaluate` の中身はブラウザで動くので、この 1 ファイルだけは
    // Node と DOM の両方が見えている必要がある。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  // `e2e/` は `src/` を直に読みます（盤面のモデルと置き場所、ADR 0041）。
  // 焼き込みの宣言（`__EKANBAN_VERSION__`）もそこから辿るので、こちらにも入れます。
  "include": [
    "e2e",
    "e2e-demo",
    "playwright.config.ts",
    "playwright.demo.config.ts",
    "src/vite-env.d.ts"
  ]
}
